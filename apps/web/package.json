{
  "name": "@helpos/web",
  "version": "0.0.0",
  "private": true,
  "description": "The dashboard: a React SPA that uses only the public API.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-budget.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "pnpm --filter @helpos/server openapi && openapi-typescript src/api/openapi.json -o src/api/schema.gen.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@helpos/brand": "workspace:*",
    "@tanstack/react-query": "5.106.0",
    "@tanstack/react-router": "1.170.46",
    "clsx": "2.1.1",
    "lucide-react": "1.68.0",
    "motion": "14.9.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5"
  }
}
