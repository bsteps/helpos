{
  "name": "@helpos/server",
  "version": "0.0.0",
  "private": true,
  "description": "The API server (Hono).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "init": "node --env-file-if-exists=../../.env src/cli/init.ts",
    "ai-budget": "node --env-file-if-exists=../../.env src/cli/ai-budget.ts",
    "token": "node --env-file-if-exists=../../.env src/cli/token.ts",
    "seed": "node --env-file-if-exists=../../.env src/cli/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "node src/cli/openapi.ts",
    "e2e-server": "node src/e2e/serve.ts",
    "test:page-fetch": "vitest run --config vitest.page-fetch.config.ts"
  },
  "dependencies": {
    "@helpos/ai": "workspace:*",
    "@helpos/brand": "workspace:*",
    "@helpos/db": "workspace:*",
    "@helpos/files": "workspace:*",
    "@helpos/safe-fetch": "workspace:*",
    "@hono/node-server": "2.1.6",
    "@hono/zod-openapi": "1.6.3",
    "@octokit/core": "7.0.8",
    "hono": "4.13.16",
    "htmlparser2": "12.0.0",
    "nodemailer": "10.3.1",
    "pino": "10.4.0",
    "postal-mime": "4.2.0",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/sanitize-html": "2.16.2",
    "testcontainers": "12.2.1"
  }
}
