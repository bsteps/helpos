{
  "name": "@helpos/server",
  "version": "0.0.0",
  "private": true,
  "description": "The API server (Hono).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "init": "node --env-file-if-exists=../../.env src/cli/init.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@helpos/ai": "workspace:*",
    "@helpos/brand": "workspace:*",
    "@helpos/db": "workspace:*",
    "@helpos/files": "workspace:*",
    "@hono/node-server": "2.1.6",
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.16",
    "nodemailer": "10.3.1",
    "pino": "10.4.0",
    "postal-mime": "4.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/nodemailer": "8.0.2",
    "testcontainers": "12.2.1"
  }
}
