{
  "name": "@helpos/db",
  "version": "0.0.0",
  "private": true,
  "description": "Database access: Drizzle schema, migrations and withTenant(). The only package allowed to touch the raw client.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./actor": "./src/actor.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=../../.env src/migrate-cli.ts",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "better-auth": "1.7.17",
    "drizzle-orm": "0.45.4",
    "pg-boss": "12.38.0",
    "postgres": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "drizzle-kit": "0.31.11"
  }
}
