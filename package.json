{
  "name": "helpos",
  "private": true,
  "description": "The open-source, agent-first helpdesk.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "verify": "biome ci . && turbo run typecheck test build && pnpm eval",
    "eval": "pnpm --filter @helpos/ai eval",
    "rename-brand": "node scripts/rename-brand.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "24.19.2",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
