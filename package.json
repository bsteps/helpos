{
  "name": "helpos",
  "private": true,
  "description": "The open-source, agent-first helpdesk.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "vitest run --config vitest.coverage.config.mts",
    "test:performance": "pnpm --filter @helpos/server exec node scripts/read-budget.ts",
    "check:widget": "node scripts/check-widget-budget.mjs",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:changed": "node scripts/check-changed/index.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\" \".claude/skills/**/*.test.mjs\"",
    "verify": "biome ci . && pnpm knip && turbo run typecheck test build && pnpm eval && pnpm demo:check",
    "eval": "pnpm --filter @helpos/ai eval",
    "helpos:init": "pnpm --filter @helpos/server run init",
    "helpos:ai-budget": "pnpm --filter @helpos/server run ai-budget",
    "helpos:token": "pnpm --filter @helpos/server run token",
    "db:seed": "pnpm --filter @helpos/server run seed",
    "dev:send-email": "node --env-file-if-exists=.env scripts/send-email.mjs",
    "rename-brand": "node scripts/rename-brand.mjs",
    "setup:worktree": "node scripts/setup-worktree.mjs",
    "demo:check": "node scripts/check-demo-compose.mjs",
    "test:e2e": "pnpm --filter @helpos/web build && pnpm --filter @helpos/web test:e2e",
    "knip": "knip",
    "api": "node .claude/skills/verify-helpos/scripts/api.mjs",
    "new-email": "node .claude/skills/verify-helpos/scripts/new-email.mjs",
    "approve-draft": "node .claude/skills/verify-helpos/scripts/approve-draft.mjs",
    "github-webhook": "node .claude/skills/verify-helpos/scripts/github-webhook.mjs",
    "app:start": "node .claude/skills/verify-helpos/scripts/launch.mjs",
    "app:doctor": "node .claude/skills/verify-helpos/scripts/doctor.mjs",
    "app:stop": "node .claude/skills/verify-helpos/scripts/cleanup.mjs",
    "app:password": "node .claude/skills/verify-helpos/scripts/owner-password.mjs",
    "app:info": "node .claude/skills/verify-helpos/scripts/instance.mjs",
    "app:journey": "node .claude/skills/verify-helpos/scripts/journey-reply.mjs",
    "app:run": "node .claude/skills/verify-helpos/scripts/instance.mjs run",
    "app:selftest": "node .claude/skills/verify-helpos/scripts/selftest.mjs",
    "verify:send-reply": "node .claude/skills/verify-send-reply/scripts/check.mjs",
    "verify:send-reply:mutations": "node .claude/skills/verify-send-reply/scripts/prove-mutations.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "knip": "6.44.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
