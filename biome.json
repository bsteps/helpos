{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/coverage", "!**/*.gen.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**", "!packages/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "postgres": "ADR 0003: only packages/db may use the raw database client. Use withTenant() from @helpos/db.",
                  "drizzle-orm/postgres-js": "ADR 0003: only packages/db may use the raw database client. Use withTenant() from @helpos/db.",
                  "drizzle-orm": "Import query helpers (eq, sql, ...) from @helpos/db. A second drizzle-orm copy breaks its types.",
                  "pg-boss": "Use enqueue() and createJobRunner() from @helpos/db, so jobs stay tenant-scoped."
                }
              }
            }
          }
        }
      }
    }
  ]
}
