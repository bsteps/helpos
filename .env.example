# Local development settings. `pnpm dev` copies this file to .env on first run.
# The defaults match docker-compose.yml, so a fresh clone works without edits.
# Never commit .env. Never put real secrets in this file.

# --- Database (Postgres 17 + pgvector, from docker-compose.yml) ---

# Used by the server. Connects as `helpos_app`, a role WITHOUT BYPASSRLS, so row-level
# security always applies (ADR 0003). Required.
HELPOS_DATABASE_URL=postgres://helpos_app:helpos_app@localhost:5432/helpos

# Used only to run migrations. Connects as `helpos_owner`, which owns the schema. Required for
# `pnpm --filter @helpos/db migrate` (and so for `pnpm dev`).
HELPOS_DATABASE_OWNER_URL=postgres://helpos_owner:helpos_owner@localhost:5432/helpos

# --- Server ---

# Port the API server listens on. Optional, default 3000.
HELPOS_PORT=3000

# Log level: fatal, error, warn, info, debug or trace. Optional, default info.
HELPOS_LOG_LEVEL=info

# --- Email (local) ---
# Mailpit catches all outgoing email: SMTP on localhost:1025, web UI at http://localhost:8025.
# No variables yet; sending email arrives with MVP step 2.
