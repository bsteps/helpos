# Local development settings. `pnpm dev` copies this file to .env on first run.
# The defaults match docker-compose.yml, so a fresh clone works without edits.
# Never commit .env. Never put real secrets in this file.

# --- Database (Postgres 17 + pgvector, from docker-compose.yml) ---

# Used by the server. Connects as `helpos_app`, a role WITHOUT BYPASSRLS, so row-level
# security always applies (ADR 0003). Required.
HELPOS_DATABASE_URL=postgres://helpos_app:helpos_app@localhost:5432/helpos

# Used only to run migrations. Connects as `helpos_owner`, which owns the schema. Required for
# `pnpm --filter @helpos/db migrate` (and so for `pnpm dev`).
HELPOS_DATABASE_OWNER_URL=postgres://helpos_owner:helpos_owner@localhost:5432/helpos

# Used only by the auth module and `pnpm helpos:init`. Connects as `helpos_auth`, the only role
# that can use the `auth` schema (users, ADR 0009). Required for `pnpm helpos:init`.
# The server also uses it, only to read owner emails for "a draft is waiting" notices.
# Optional for the server: without it, those notices wait in the queue.
HELPOS_DATABASE_AUTH_URL=postgres://helpos_auth:helpos_auth@localhost:5432/helpos

# Used by the migrate step and the job runner. Connects as `helpos_jobs`, the only role that can
# use pg-boss's `pgboss` schema. Required for the server and `pnpm --filter @helpos/db migrate`.
HELPOS_DATABASE_JOBS_URL=postgres://helpos_jobs:helpos_jobs@localhost:5432/helpos

# --- Server ---

# Port the API server listens on. Optional, default 3000.
HELPOS_PORT=3000

# Log level: fatal, error, warn, info, debug or trace. Optional, default info.
HELPOS_LOG_LEVEL=info

# Where the dashboard runs. Links in emails and password setup links point here, and browser
# requests that change something are refused from any other origin (CSRF). In development that
# is the Vite dev server that `pnpm dev` starts; in production the server serves the dashboard
# itself (HELPOS_WEB_DIR), so it is the server's own public URL. Optional, default
# http://localhost:3000.
HELPOS_PUBLIC_URL=http://localhost:5180

# Signs dashboard session cookies. At least 32 characters. Optional: without it (or without
# HELPOS_DATABASE_AUTH_URL) nobody can sign in to the dashboard; agent tokens still work.
# This value is for local dev only; generate your own with `openssl rand -hex 32`.
HELPOS_AUTH_SECRET=dev-only-auth-secret-change-me-0123456789abcdef

# The built dashboard (`pnpm --filter @helpos/web build` writes apps/web/dist), served at /.
# A relative path is relative to apps/server, where the server runs. Optional: unset, the server
# serves only the API. Not needed with `pnpm dev`, which runs the dashboard's own dev server.
# HELPOS_WEB_DIR=../web/dist

# --- Email ---

# How long a new draft waits before workspace owners are emailed about it, in seconds. A draft
# approved sooner never causes an email. Optional, default 300 (5 minutes).
HELPOS_NOTICE_DELAY_SECONDS=300

# Shadow mode (on for every workspace) sends each reply to the workspace's shadow recipient,
# never to the customer. Turning it off is refused unless this is true. Keep it false until the
# release safety work (Set 2a) ships. Optional, default false.
HELPOS_ALLOW_SHADOW_MODE_OFF=false
# Mailpit catches all outgoing email: SMTP on localhost:1025, web UI at http://localhost:8025.

# Shared secret for POST /v1/inbound/email. Your email provider sends it as
# `Authorization: Bearer <secret>`. At least 32 characters. Optional: when empty, inbound email
# is refused. This value is for local dev only; generate your own with `openssl rand -hex 32`.
HELPOS_INBOUND_SECRET=dev-only-inbound-secret-change-me-0123456789

# SMTP server that approved replies are sent through. Only the background worker sends.
# Optional: when empty, approved replies wait in the queue. The default is local Mailpit.
HELPOS_SMTP_URL=smtp://localhost:1025

# Where raw emails and attachments are stored (local-disk files adapter, ADR 0002).
# Optional, default .data/files (relative to the server's working directory).
HELPOS_FILES_DIR=.data/files

# --- AI (Vercel AI SDK, ADR 0002) ---
# Only needed for real AI calls. Tests and `pnpm eval` use a mock model and ignore these.
# To run evals against the real model locally: EVAL_LIVE=1 pnpm eval (never in CI).

# Provider: openai or anthropic. Required for live AI calls.
AI_PROVIDER=anthropic
# Model id for that provider, e.g. claude-haiku-5-5. Required for live AI calls.
AI_MODEL=claude-haiku-5-5
# Your own API key. Leave it empty here and set it in .env, which is never committed.
AI_API_KEY=
# Hard cap on AI tokens per workspace per UTC day (input + output). At the cap, drafting stops
# before calling the model and conversations are marked "AI paused" until UTC midnight.
# This is the server-wide ceiling: an operator can give one workspace less with
# `pnpm helpos:ai-budget`, never more. Optional, default 200000.
HELPOS_AI_DAILY_TOKEN_BUDGET=200000

# --- Knowledge base embeddings ---
# Knowledge sources are split into passages and embedded, so drafts can quote the ones that
# match. Separate from the chat model, because not every provider offers embeddings (Anthropic
# doesn't). Optional: when unset, new sources wait in the queue and drafts use no knowledge.
# Embedding tokens count toward HELPOS_AI_DAILY_TOKEN_BUDGET. Tests use a mock and ignore these.
# The model must give 1024-dimension vectors: OpenAI text-embedding-3-* (asked for 1024), or a
# local model such as mxbai-embed-large or bge-m3.

# Provider: openai, which also covers any OpenAI-compatible server (see the base URL below).
AI_EMBEDDING_PROVIDER=
# Model id. Optional, default text-embedding-3-small.
AI_EMBEDDING_MODEL=
# Your own API key. Required for OpenAI itself; a local server usually needs none.
# Leave it empty here and set it in .env, which is never committed.
AI_EMBEDDING_API_KEY=
# An OpenAI-compatible server instead of OpenAI, e.g. Ollama at http://localhost:11434/v1
# (with AI_EMBEDDING_MODEL=mxbai-embed-large). Optional.
AI_EMBEDDING_BASE_URL=

# --- GitHub (conversation → issue → "it's fixed") ---

# Encrypts integration secrets at rest (the GitHub token, webhook secrets), AES-256-GCM: 32 bytes
# as 64 hex characters or base64. Optional: without it, no GitHub repo can be connected. Changing
# it makes stored tokens unreadable, so connect the repo again afterwards. Deliberately empty
# here, so no one ever encrypts real tokens under a key published in this repo: `pnpm dev` puts
# a random one in your .env. Elsewhere, generate your own with `openssl rand -base64 32`.
HELPOS_ENCRYPTION_KEY=

# The GitHub API. Optional, default https://api.github.com; set it for GitHub Enterprise Server.
# HELPOS_GITHUB_API_URL=https://api.github.com
