# Demo instance settings. Copy to .env (never committed) and replace EVERY value.
# Make each secret and password with: openssl rand -hex 32

# The domain the demo is served at. Its DNS A/AAAA record must point at this VPS.
HELPOS_DOMAIN=demo.example.com

# --- Database passwords (used once, when the database is first created) ---
POSTGRES_SUPERUSER_PASSWORD=change-me
HELPOS_OWNER_DB_PASSWORD=change-me
HELPOS_APP_DB_PASSWORD=change-me
HELPOS_AUTH_DB_PASSWORD=change-me
HELPOS_JOBS_DB_PASSWORD=change-me

# --- Server ---
# Signs dashboard session cookies. At least 32 characters.
HELPOS_AUTH_SECRET=change-me-change-me-change-me-change-me
# The inbound email webhook sends this as `Authorization: Bearer <secret>`. At least 32 characters.
HELPOS_INBOUND_SECRET=change-me-change-me-change-me-change-me
# Real SMTP, for shadowed replies to the partner and "a draft is waiting" notices. It must be
# allowed to send from HELPOS_DOMAIN (SPF/DKIM): every workspace mailbox is on that domain.
# For example: smtps://user:password@smtp.example.com:465
HELPOS_SMTP_URL=smtp://user:password@smtp.example.com:587
HELPOS_LOG_LEVEL=info

# Shadow mode is locked on in compose.yaml. HELPOS_ALLOW_SHADOW_MODE_OFF here has no effect.

# --- AI ---
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-5-5
AI_API_KEY=
HELPOS_AI_DAILY_TOKEN_BUDGET=200000
# Optional: embeddings for the knowledge base (see docs/self-hosting.md).
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=
