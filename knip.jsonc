// knip finds unused files, exports and dependencies. `pnpm knip` runs it; CI and `pnpm verify` too.
// Every ignore below says why. Prefer deleting the code to adding an ignore.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": {
      "includeEntryExports": true
    },
    "packages/ai": {
      "includeEntryExports": true,
      // The reply-helpfulness eval runner, run by hand with node (see its README).
      "entry": ["evals/helpfulness/run-eval.mjs"]
    },
    ".": {
      // Repo tooling.
      "entry": ["scripts/**/*.mjs"]
    },
    "apps/server": {
      "entry": [
        "src/worker.ts",
        "src/cli/{init,token,ai-budget,seed,openapi}.ts",
        "scripts/read-budget.ts"
      ]
    },
    "apps/web": {
      // Playwright picks up *.setup.ts through a testMatch regex knip can't read.
      "entry": ["scripts/*.mjs", "e2e/**/*.setup.ts"]
    }
  },
  // Java runs the pinned TLC model checker; it is a system prerequisite, not an npm binary.
  "ignoreBinaries": ["java"]
}
